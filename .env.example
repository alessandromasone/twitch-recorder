# ── Twitch Recorder — Configurazione ──

# File JSON per lo stato dei canali
CHANNELS_FILE=channels.json

# Cartella dove salvare le registrazioni
RECORDINGS_DIR=recordings

# Estensione file video (.ts, .mp4, .mkv)
FILE_EXTENSION=.ts

# Formato nome file (variabili: {name}, {timestamp}, {ext})
FILENAME_FORMAT={name}_{timestamp}{ext}

# Qualità stream: best, worst, 720p, 480p, ecc.
STREAM_QUALITY=best

# Intervallo di controllo canali (secondi)
CHECK_INTERVAL=60

# Porta del server web
PORT=5000

# Dimensione massima file prima dello split (byte) — default ~1.8 GB
MAX_FILE_SIZE=1932735283

# Livello di log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Chiave segreta Flask (lascia vuoto per generazione automatica)
# SECRET_KEY=
