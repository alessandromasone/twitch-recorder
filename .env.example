# ── Twitch Recorder — Configurazione ──

CHANNELS_FILE=channels.json
RECORDINGS_DIR=recordings
FILE_EXTENSION=.ts
FILENAME_FORMAT={name}_{timestamp}{ext}
STREAM_QUALITY=best
# Credenziali di un'app Twitch (https://dev.twitch.tv/console/apps), consigliate.
# Con le credenziali i controlli Twitch usano l'API Helix: una richiesta HTTP ogni 100 canali
# invece di un processo Streamlink per canale, più titolo, categoria, spettatori e avatar.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# auto = Helix se ci sono le credenziali | helix | streamlink (comportamento precedente)
TWITCH_CHECK_METHOD=auto
# Con Helix i canali Twitch offline possono essere controllati più spesso a costo quasi nullo
HELIX_OFFLINE_CHECK_INTERVAL=20

# ── Rerun ──
# true = le rerun dichiarate (tag ufficiale o titolo «Rerun») non vengono mai registrate
SKIP_RERUNS=false
# Cosa fare quando una live sembra una rerun non dichiarata (modificabile per canale):
#   mark   = registra e segna il file (predefinito, non perde mai nulla)
#   skip   = non registrare le rerun probabili
#   record = ignora i sospetti
RERUN_DEFAULT_POLICY=mark
# Soglie del punteggio 0-100: da qui la live è «possibile» e «probabile» rerun
RERUN_SUSPECT_SCORE=40
RERUN_PROBABLE_SCORE=70
# Streamlink recente filtra automaticamente le ads incorporate di Twitch;
# sulle versioni che supportano ancora l'opzione legacy, true la abilita esplicitamente.
SKIP_TWITCH_ADS=true
CHECK_INTERVAL=60
# Monitor concorrente e intervalli adattivi (le richieste simultanee sono limitate)
MONITOR_WORKERS=2
ONLINE_CHECK_INTERVAL=30
OFFLINE_CHECK_INTERVAL=60
ERROR_CHECK_INTERVAL=120
OFFLINE_CONFIRMATIONS=3
OFFLINE_CONFIRM_INTERVAL=5
RECORDER_OFFLINE_GRACE_SECONDS=15
# Buffer in memoria per usare il flusso REC anche nel player senza seconda connessione
LIVE_STREAM_BUFFER_BYTES=4194304
# La preview tollera le pause di output di Streamlink durante le pubblicità incorporate.
# Tempo massimo senza il primo pacchetto e tra pacchetti successivi.
PREVIEW_STARTUP_TIMEOUT_SECONDS=120
PREVIEW_IDLE_TIMEOUT_SECONDS=180
# Secondi in cui la sorgente temporanea resta aperta dopo la chiusura dell'ultimo player
PREVIEW_LINGER_SECONDS=10
# Interfaccia minimal: lista densa di solo testo, senza copertine e avatar (ogni browser può cambiarla)
MINIMAL_UI=false
# Miniature delle registrazioni concluse (generate una volta con FFmpeg, in recordings/.thumbs).
# Vuoto = attive, tranne con MINIMAL_UI=true
RECORDING_THUMBS=
PORT=5000
# Porta host per docker-compose.preview.yml (non usata dalla produzione)
PREVIEW_PORT=5001
MAX_FILE_SIZE=1932735283
LOG_LEVEL=INFO
# Login opzionale: lascia APP_PASSWORD vuota per mantenere l'accesso senza password.
APP_PASSWORD=
# Imposta una chiave lunga e casuale; importante se APP_PASSWORD è attiva.
SECRET_KEY=
# Imposta true soltanto se l'app è servita tramite HTTPS (per esempio con reverse proxy).
SESSION_COOKIE_SECURE=false
APP_SESSION_HOURS=12

# Funzioni facoltative sui file completati (disattivate per default)
AUTO_CONVERT=false
# Elimina il .ts soltanto dopo una conversione MP4 completata con successo; per default conserva l'originale
DELETE_AFTER_CONVERT=false
DEDUP_ENABLED=false
DEDUP_BYTES=2097152
# Vuoto = indice persistente in /data/dedup_hashes.json nel container
DEDUP_FILE=

# ── Anti-spam ──
JITTER_MAX=10

# ── Retry intelligente ──
RECONNECT_WAIT=30
RECONNECT_TRIES=3

# ── Notifiche ──
# Tipo: discord | telegram | webhook | (vuoto per disattivare)
NOTIFY_TYPE=
# Eventi da notificare (comma-separated): online, offline, rec_start, rec_end
NOTIFY_EVENTS=online,offline,rec_start,rec_end

# Discord: inserisci l'URL del webhook
NOTIFY_URL=

# Telegram: inserisci token del bot e chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Invia screenshot della live quando va online (solo Telegram)
TELEGRAM_NOTIFY_PHOTO=true
