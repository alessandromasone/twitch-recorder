# ── Twitch Recorder — Configurazione ──

CHANNELS_FILE=channels.json
RECORDINGS_DIR=recordings
FILE_EXTENSION=.ts
FILENAME_FORMAT={name}_{timestamp}{ext}
STREAM_QUALITY=best
CHECK_INTERVAL=60
PORT=5000
MAX_FILE_SIZE=1932735283
LOG_LEVEL=INFO
# SECRET_KEY=

# ── Anti-spam ──
JITTER_MAX=10
CHECK_PAUSED_ROOMS=false

# ── Retry intelligente ──
RECONNECT_WAIT=30
RECONNECT_TRIES=3

# ── Notifiche ──
# Tipo: discord | telegram | webhook | (vuoto per disattivare)
NOTIFY_TYPE=
# Eventi da notificare (comma-separated): online, offline, rec_start, rec_end
NOTIFY_EVENTS=online,offline,rec_start,rec_end

# Discord: inserisci l'URL del webhook
NOTIFY_URL=

# Telegram: inserisci token del bot e chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Invia screenshot della live quando va online (solo Telegram)
TELEGRAM_NOTIFY_PHOTO=true
