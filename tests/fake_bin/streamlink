#!/usr/bin/env python3
import sys, json, os, time
args = sys.argv[1:]
if "--version" in args:
    if "--twitch-disable-ads" in args: sys.exit(2)
    print("streamlink 8.6.1"); sys.exit(0)
url = next((a for a in args if a.startswith("http")), "")
name = url.rstrip("/").split("/")[-1]
# live* = flusso continuo; stall* = pochi dati e poi silenzio con la connessione aperta;
# child* = come live ma con un processo figlio che tiene aperta la pipe (come il muxer FFmpeg).
# mute* = risulta online, apre il flusso ma esce subito senza video (Kick appena andato offline);
# silent* = risulta online, apre il flusso e non invia mai dati.
live = name.startswith(("live", "stall", "child", "mute", "silent"))
if "--json" in args:
    if live:
        print(json.dumps({"plugin":"twitch","metadata":{"id":"1","author":name,"category":"Just Chatting","title":json.loads(os.environ.get("FAKE_TITLES","{}")).get(name,"Titolo di "+name)},"streams":{"720p":{},"best":{}}}))
    else:
        print(json.dumps({"error":"No playable streams found on this URL: "+url})); sys.exit(1)
    sys.exit(0)
if "--stdout" in args:
    if not live:
        print("error: No playable streams found", file=sys.stderr); sys.exit(1)
    q = args[-1].split(",")[0]
    print(f"[cli][info] Opening stream: {q} (hls)", file=sys.stderr, flush=True)
    if name.startswith("mute"):
        time.sleep(0.3); sys.exit(0)
    if name.startswith("silent"):
        time.sleep(600); sys.exit(0)
    src = os.environ.get("FAKE_TS")
    with open(src, "rb") as fh:
        data = fh.read()
    out = sys.stdout.buffer
    if name.startswith("child"):
        import subprocess
        subprocess.Popen(["sleep", "600"])   # eredita stdout come farebbe un muxer
    if name.startswith("stall"):
        out.write(data[:188 * 2000]); out.flush()
        time.sleep(600)
        sys.exit(0)
    try:
        while True:
            for i in range(0, len(data), 188*700):
                out.write(data[i:i+188*700]); out.flush(); time.sleep(0.25)
    except (BrokenPipeError, KeyboardInterrupt):
        pass
